# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
ALTERNATIVE_PAYMENTS_CLIENT_ID=
ALTERNATIVE_PAYMENTS_CLIENT_SECRET=
# production (default) or demo. Not a credential. Gateway compose may
# interpolate ALTERNATIVE_PAYMENTS_ENVIRONMENT only if you add it yourself;
# the checked-in gateway service does not.
ALTERNATIVE_PAYMENTS_ENVIRONMENT=production

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address when CONDUIT_S2S_SECRET is set. Unset keeps the historical
# default of 0.0.0.0. The container image and Compose set 0.0.0.0 explicitly.
# Without a real secret, MCP_ALLOW_INSECURE_DEV=1 ignores this and binds
# 127.0.0.1 only.
# MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. Leave this empty.
# The process logs an error and exits non-zero when this is empty or a known
# placeholder (changeme, your-s2s-secret, secret, placeholder, ...), so a
# copied example cannot forge X-Gateway-S2S. docker compose will not start
# when it is unset. Never commit a real secret. The value is never logged.
# Generate one with: openssl rand -hex 32
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a loud warning, does not check
# X-Gateway-S2S, and binds 127.0.0.1 even if MCP_HTTP_HOST is a wider
# address such as 0.0.0.0. A known placeholder is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Alternative-Payments-Client-ID and X-Alternative-Payments-Client-Secret
# headers; no env fallback). The container image and Compose set gateway.
# Stdio ignores this and reads ALTERNATIVE_PAYMENTS_* from the environment.
# AUTH_MODE=gateway

LOG_LEVEL=info
